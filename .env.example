# Copy this file to .env and fill in real values. .env is gitignored.

# Required for `npm run crawl` -- the agent loop calls Claude directly.
ANTHROPIC_API_KEY=

# fixtures (default, free, offline) or live (real twitterapi.io calls, costs money).
SCRAPER=fixtures

# Only needed once SCRAPER=live.
TWITTERAPI_IO_KEY=
